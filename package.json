{
  "name": "eventdex",
  "description": "Eventos presenciales convertidos en un juego de colección",
  "author": {
    "name": "Mauro Daniel Viveros (TRY Ubbe)",
    "email": "maurod.viveros@gmail.com",
    "url": "https://github.com/mauroviveros"
  },
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mauroviveros/eventdex.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && biome format --write src/lib/supabase/database.types.ts",
    "db:push": "supabase db push"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
