# Copiá este archivo a .env.local y completalo. Nunca commitees .env.local.

# Dominio raíz: sirve la landing y el panel (/panel). Cualquier otro host es una org.
# Local: localhost:3000 · Producción: eventdex.vercel.app
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase: se suman al esquema de src/lib/env.ts en R1, cuando se usen.
# Local: los imprime `pnpm db:start` (o `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Se saltea RLS. Solo servidor, solo en src/lib/supabase/service.ts.
SUPABASE_SECRET_KEY=
